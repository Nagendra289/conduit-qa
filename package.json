{
  "name": "conduit-qa",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test suite for the Conduit RealWorld app",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "stub:api": "node tools/stub-api.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2"
  },
  "private": true
}
